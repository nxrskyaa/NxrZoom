[Unit]
Description=Yukaya by NxrLabs — Telegram signal bot (nxrzoom engine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/nxrzoom/bot
ExecStart=/usr/bin/node /home/ubuntu/nxrzoom/bot/bot.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
